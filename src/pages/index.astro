---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import Star from '../components/Star.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Contact from '../components/Contact.astro';
import CountUp from '../components/CountUp.astro';
import {publishedProjects as projects,projectNoun,services,faq,contact} from '../data/content';
---
<Layout>
<section class="hero container"><div class="hero-eyebrow"><span><span class="status-dot"></span> НЕЗАВИСИМЫЙ ДИЗАЙНЕР И РАЗРАБОТЧИК</span><span class="hero-coordinate">ПОРТФОЛИО / 2026</span></div>
 <div class="hero-heading"><h1>Делаю сайты<br/>для вашего <span>бизнеса</span></h1><Star class="hero-star"/></div>
 <div class="hero-intro"><p>От первой идеи до работающего сайта.<br/>Продумываю структуру, делаю дизайн<br class="desktop-break"/> и собираю всё в удобный продукт.</p><div class="hero-actions"><a class="button button-green" href={contact} target="_blank" rel="noopener noreferrer">Обсудить проект <Arrow/></a><a class="text-link" href="#work">Смотреть работы <span>↓</span></a></div></div>
 <div class="hero-showcase" aria-label="Превью проектов"><div class="showcase-grid" aria-hidden="true"></div><span class="showcase-caption">ИДЕИ ПРИОБРЕТАЮТ ФОРМУ</span><a href="/cases/korean-school/" class="hero-screen screen-left" aria-label="Кейс школы корейского"><img src={projects[2].coverImage} alt="Кейс школы корейского"/></a><a href="/cases/detailing/" class="hero-screen screen-center" aria-label="Кейс детейлинг-центра"><img src={projects[0].coverImage || projects[0].image} alt="Кейс детейлинг-центра"/></a><a href="/cases/car-wrapping/" class="hero-screen screen-right" aria-label="Кейс оклейки автомобилей"><img src={projects[1].coverImage} alt="Кейс оклейки автомобилей"/></a><div class="floating-label"><span class="status-dot"></span> Продумано до клика <span>↗</span></div><span class="showcase-bottom">ДИЗАЙН + РАЗРАБОТКА</span></div>
 <div class="hero-footnote"><span>Сайты / Боты / Интеграции</span><span>Хороший сайт начинается с вашей задачи. ↙</span></div>
</section>
<section class="section container services-section" id="services"><div class="section-heading" data-reveal><div class="section-label">01 / ЧЕМ МОГУ ПОМОЧЬ</div><div><h2>Ваша задача<br/><span class="muted">Моё решение</span></h2><p>Сделаю сайт с нуля или подключусь<br/>там, где нужна помощь.</p></div></div><div class="services-list">{services.map(([name,number,description])=><details class="service-row" name="services" data-reveal><summary><span class="row-number">{number}</span><h3>{name}</h3><span class="service-mark" aria-hidden="true">+</span></summary><div class="service-content"><p>{description}</p><a class="text-link" href={contact} target="_blank" rel="noopener noreferrer">Обсудить задачу <Arrow/></a></div></details>)}</div></section>
<section class="numbers-section"><div class="container"><div class="numbers-top"><span class="section-label">02 / БЛИЖЕ К ДЕЛУ</span><p>За каждым сайтом стоят решения.<br/>Вот несколько точек отсчёта.</p></div><div class="numbers-grid"><div><CountUp value={projects.length} arrow/><p>{projectNoun} в портфолио</p></div><div><CountUp value={services.length}/><p>направлений работы</p></div><div><CountUp value={1}/><p>человек на связи. Это я.</p></div></div><div class="numbers-bottom"><span>От структуры до последней кнопки</span><Star/></div></div></section>
<section class="section container" id="work"><div class="work-heading" data-reveal><div><div class="section-label">03 / ИЗБРАННЫЕ ПРОЕКТЫ</div><h2>Лучше <span class="muted">показать</span></h2></div><a class="text-link" href="/cases/">Все кейсы <Arrow/></a></div><div class="projects-grid">{projects.map(project=><ProjectCard project={project}/>)}</div></section>
<section class="section container faq-section" id="faq"><div class="section-heading" data-reveal><div><div class="section-label">04 / ПЕРЕД СТАРТОМ</div><h2>Пара<br/><span class="muted">вопросов</span></h2><p>Не нашли свой?<br/><a class="underlined" href={contact} target="_blank" rel="noopener noreferrer">Напишите мне в Telegram ↗</a></p></div><div class="faq-list">{faq.map(([question,answer])=><details class="faq-row" name="faq"><summary><h3>{question}</h3><span class="service-mark" aria-hidden="true">+</span></summary><div class="faq-answer"><p>{answer}</p></div></details>)}</div></div></section>
<Contact/>
</Layout>
