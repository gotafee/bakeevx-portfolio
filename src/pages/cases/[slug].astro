---
import Layout from '../../layouts/Layout.astro';
import Mockup from '../../components/Mockup.astro';
import Arrow from '../../components/Arrow.astro';
import Contact from '../../components/Contact.astro';
import {projects} from '../../data/content';
export function getStaticPaths(){return projects.map((project,index)=>({params:{slug:project.slug},props:{project,index}}))}
const {project:p,index}=Astro.props;
const prev=projects[(index+projects.length-1)%projects.length];
const next=projects[(index+1)%projects.length];
---
<Layout title={`${p.name} | Кейс bakeevx`} description={p.summary}>
<article><header class="container case-header"><a class="text-link back-link" href="/cases/">← Все кейсы</a><div class="case-meta"><span class="section-label">ПРОЕКТ {p.number} / {projects.length}</span><span>{p.category}</span></div><h1>{p.name}</h1><div class="case-intro"><p>{p.summary}</p><span>{p.role}</span></div></header>
<div class:list={['container','case-cover',`stage-${p.slug}`]}>{p.coverImage ? <img class="real-project-cover" src={p.coverImage} alt={p.imageAlt || p.name} width="1400" height="1000"/> : <div class="case-cover-window"><Mockup project={p} eager/></div>}</div>
<section class="container case-text section" data-reveal><div class="section-label">01 / ЗАДАЧА</div><div><h2>С чего всё<br/><span class="muted">началось</span></h2><p>{p.task}</p></div></section>
<section class="container case-solution section" data-reveal><div class="section-label">02 / ЧТО Я СДЕЛАЛ</div><div><h2>От задачи<br/><span class="muted">к решению</span></h2><p>{p.solution}</p><ol class="steps">{p.steps.map((step,i)=><li><span>0{i+1}</span>{step}</li>)}</ol></div></section>
<section class="container case-gallery"><div class="gallery-heading"><span class="section-label">03 / ПОБЛИЖЕ</span></div>{p.gallery.map((item,i)=><figure class:list={['gallery-item',`gallery-${item.variant}`,item.video?'gallery-video':'']} data-reveal><div class:list={['gallery-stage',`stage-${p.slug}`]}>{item.variant==='mobile'&&<div class="mobile-stage-title" aria-hidden="true">Удобно.<br/>Даже<br/><span>на ходу.</span></div>}{item.video ? <div class="video-player" data-video-player><video src={item.video} muted playsinline preload="metadata" aria-label={item.title}></video><button class="video-play" type="button" aria-label="Воспроизвести видео"><span class="play-icon">▶</span></button><div class="video-controls"><button class="video-control video-toggle" type="button" aria-label="Воспроизвести видео"><span class="play-icon">▶</span></button><span class="video-time">0:00 / 0:00</span><input class="video-progress" type="range" min="0" max="100" value="0" aria-label="Позиция видео"/><button class="video-control video-mute" type="button" aria-label="Включить звук">◉</button></div></div> : item.image ? <img class="real-gallery-image" src={item.image} alt={item.imageAlt || item.title} width="1400" height="1000" loading="lazy"/> : <div class="gallery-window"><Mockup project={p} variant={item.variant}/></div>}</div><figcaption><span>0{i+1} / {item.title}</span><p>{item.caption}</p></figcaption></figure>)}</section>
<section class="case-results"><div class="container"><div class="results-heading"><div><div class="section-label">04 / РЕЗУЛЬТАТ</div><h2>Что получилось</h2></div>{p.demo&&<span class="demo-badge">Демонстрационные данные</span>}</div><p class="results-description">{p.outcome}</p>{p.period&&<p class="results-period">{p.demo ? "Пример периода" : "Период"}: {p.period}</p>}<div class="result-metrics">{p.metrics.map(m=><div><strong>{m.value}</strong><span>{m.label}</span></div>)}</div>{p.period&&p.demo&&<div class="analytics-demo"><div class="analytics-top"><span>Обращения с сайта</span><span>Демонстрационные данные</span></div><div class="chart" role="img" aria-label="Демонстрационная диаграмма обращений, не реальная аналитика">{[18,30,26,43,36,57,41,48,65,54,75,59,69,82,71,91,77,87,80,98].map(height=><span style={`--bar-height:${height}%`}></span>)}</div><div class="analytics-bottom"><span>Начало периода</span><span>Конец периода</span></div></div>}{p.evidenceImage&&<img class="evidence-image" src={p.evidenceImage} alt={p.evidenceAlt || "Источник показателей проекта"} width="1400" height="800" loading="lazy"/>}{p.demo&&<p class="results-disclaimer">Цифры показывают пример оформления результатов. Реальные показатели и материалы будут добавлены после проверки.</p>}</div></section>
<nav class="container case-pagination" aria-label="Другие кейсы"><a href={`/cases/${prev.slug}/`}><span>← Предыдущий кейс</span><strong>{prev.name}</strong></a><a href={`/cases/${next.slug}/`}><span>Следующий кейс →</span><strong>{next.name} <Arrow/></strong></a></nav>
</article><Contact/>
</Layout>
